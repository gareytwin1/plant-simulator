{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-simulator/config/schema/scenario.schema.json",
  "title": "Scenario file (contract C8)",
  "type": "object",
  "required": ["id", "plant", "initial_condition", "time_limit_s", "difficulty", "seed"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "plant": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a plant config under config/plants/ this scenario loads."
    },
    "initial_condition": {
      "type": "object",
      "required": ["condition"],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "Name of a named initial condition (config/initial_conditions/) to start from."
        },
        "overrides": {
          "type": "object",
          "description": "Free-form per-scenario adjustments layered on top of the named condition. Shape owned by T12-2's loader, not this schema."
        }
      }
    },
    "malfunctions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_tag", "parameter", "value"],
        "additionalProperties": false,
        "properties": {
          "target_tag": {"type": "string", "minLength": 1},
          "parameter": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "profile": {
            "type": "object",
            "required": ["type"],
            "description": "Tagged union on 'type' (e.g. 'step', 'ramp'); type-specific fields are enforced by app/disturbances, not this schema, the same way plant.schema.json leaves typed ports to app/plant/loader.py. Defaults to a Step profile when omitted.",
            "properties": {
              "type": {"type": "string", "minLength": 1}
            }
          },
          "start_condition": {
            "type": "object",
            "required": ["type"],
            "description": "Tagged union on 'type' (e.g. 'at_time', 'condition'); type-specific fields enforced by app/disturbances. Defaults to an immediate AtTime(0) when omitted.",
            "properties": {
              "type": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "description": "'type' selects which of the fields below applies: 'time' carries sim_time, 'condition' carries condition, 'operator_action' carries action. Every field any trigger type uses is enumerated here, so unlike malfunctions' profile/start_condition this can be additionalProperties: false.",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["time", "condition", "operator_action"]},
          "one_shot": {"type": "boolean"},
          "sim_time": {"type": "number", "minimum": 0},
          "condition": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1}
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "success"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "success": {
            "type": "object",
            "required": ["condition"],
            "additionalProperties": false,
            "properties": {
              "condition": {"type": "string", "minLength": 1},
              "hold_duration_s": {"type": "number", "minimum": 0}
            }
          },
          "failure": {
            "type": "object",
            "required": ["condition"],
            "additionalProperties": false,
            "properties": {
              "condition": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "time_limit_s": {"type": "number", "minimum": 0},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "seed": {"type": "integer"}
  }
}
